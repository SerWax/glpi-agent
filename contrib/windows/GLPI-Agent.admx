<?xml version="1.0" encoding="utf-8"?>
<policyDefinitions xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" revision="1.4" schemaVersion="1.0" xmlns="http://schemas.microsoft.com/GroupPolicy/2006/07/PolicyDefinitions">
  <policyNamespaces>
    <target prefix="GLPI-Agent" namespace="GLPI-Agent" />
    <using prefix="windows" namespace="Microsoft.Policies.Windows" />
  </policyNamespaces>
  <resources minRequiredRevision="1.4" />
  <categories>
    <category name="GLPI_ROOT" displayName="$(string.GLPI_ROOT)" />
  </categories>
  <policies>
    <!--
      Managed policy: values are written to HKLM\SOFTWARE\Policies\GLPI-Agent.
      This is a recognized Group Policy root, so the Administrative Templates
      client-side extension removes the values when the GPO stops applying
      (no tattoo), and the agent MSI never owns the key. SOFTWARE\Policies is a
      WOW64-shared key, so this single machine policy serves both the 64-bit and
      the 32-bit agent - no separate Wow6432Node policy is needed. The agent
      reads this key with priority over its legacy SOFTWARE\GLPI-Agent key.
    -->
    <policy name="GLPI_CONFIGURE" class="Machine" displayName="$(string.GLPI_CONFIGURE)" explainText="$(string.GLPI_CONFIGURE_EXPLAIN)" presentation="$(presentation.GLPI_CONFIGURE)" key="SOFTWARE\Policies\GLPI-Agent">
      <parentCategory ref="GLPI_ROOT" />
      <supportedOn ref="windows:SUPPORTED_WindowsXP" />
      <elements>
        <text id="GLPI_Server" key="SOFTWARE\Policies\GLPI-Agent" valueName="server" required="true" />
        <text id="GLPI_Proxy" key="SOFTWARE\Policies\GLPI-Agent" valueName="proxy" />
        <text id="GLPI_User" key="SOFTWARE\Policies\GLPI-Agent" valueName="user" />
        <text id="GLPI_Password" key="SOFTWARE\Policies\GLPI-Agent" valueName="password" />
        <text id="GLPI_Tag" key="SOFTWARE\Policies\GLPI-Agent" valueName="tag" />
        <text id="GLPI_ca-cert-dir" key="SOFTWARE\Policies\GLPI-Agent" valueName="ca-cert-dir" />
        <text id="GLPI_ca-cert-file" key="SOFTWARE\Policies\GLPI-Agent" valueName="ca-cert-file" />
        <text id="GLPI_ssl-fingerprint" key="SOFTWARE\Policies\GLPI-Agent" valueName="ssl-fingerprint" />
        <text id="GLPI_httpd-ip" key="SOFTWARE\Policies\GLPI-Agent" valueName="httpd-ip" />
        <text id="GLPI_httpd-port" key="SOFTWARE\Policies\GLPI-Agent" valueName="httpd-port" required="true" />
        <text id="GLPI_httpd-trust" key="SOFTWARE\Policies\GLPI-Agent" valueName="httpd-trust" required="true" />
        <text id="GLPI_no-category" key="SOFTWARE\Policies\GLPI-Agent" valueName="no-category" />
        <text id="GLPI_no-task" key="SOFTWARE\Policies\GLPI-Agent" valueName="no-task" />
        <text id="GLPI_tasks" key="SOFTWARE\Policies\GLPI-Agent" valueName="tasks" />
        <text id="GLPI_delaytime" key="SOFTWARE\Policies\GLPI-Agent" valueName="delaytime" required="true" />
        <text id="GLPI_timeout" key="SOFTWARE\Policies\GLPI-Agent" valueName="timeout" required="true" />
        <text id="GLPI_backend-collect-timeout" key="SOFTWARE\Policies\GLPI-Agent" valueName="backend-collect-timeout" required="true" />
        <text id="GLPI_debug" key="SOFTWARE\Policies\GLPI-Agent" valueName="debug" required="true" />
        <boolean id="GLPI_no-ssl-check" key="SOFTWARE\Policies\GLPI-Agent" valueName="no-ssl-check">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="GLPI_no-p2p" key="SOFTWARE\Policies\GLPI-Agent" valueName="no-p2p">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="GLPI_scan-homedirs" key="SOFTWARE\Policies\GLPI-Agent" valueName="scan-homedirs">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="GLPI_scan-profiles" key="SOFTWARE\Policies\GLPI-Agent" valueName="scan-profiles">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <boolean id="GLPI_no-httpd" key="SOFTWARE\Policies\GLPI-Agent" valueName="no-httpd">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <text id="GLPI_full-inventory-postpone" key="SOFTWARE\Policies\GLPI-Agent" valueName="full-inventory-postpone" required="true" />
        <text id="GLPI_required-category" key="SOFTWARE\Policies\GLPI-Agent" valueName="required-category" />
        <text id="GLPI_itemtype" key="SOFTWARE\Policies\GLPI-Agent" valueName="itemtype" />
        <boolean id="GLPI_json" key="SOFTWARE\Policies\GLPI-Agent" valueName="json">
          <trueValue>
            <string>1</string>
          </trueValue>
          <falseValue>
            <string>0</string>
          </falseValue>
        </boolean>
        <text id="GLPI_ssl-keystore" key="SOFTWARE\Policies\GLPI-Agent" valueName="ssl-keystore" />
        <text id="GLPI_ssl-cert-file" key="SOFTWARE\Policies\GLPI-Agent" valueName="ssl-cert-file" />
        <text id="GLPI_ssl-key-file" key="SOFTWARE\Policies\GLPI-Agent" valueName="ssl-key-file" />
        <text id="GLPI_oauth-client-id" key="SOFTWARE\Policies\GLPI-Agent" valueName="oauth-client-id" />
        <text id="GLPI_oauth-client-secret" key="SOFTWARE\Policies\GLPI-Agent" valueName="oauth-client-secret" />
      </elements>
    </policy>
  </policies>
</policyDefinitions>
